<Window x:Class="WpfLaunchSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Launch Simulation" Width="1400" Height="860" MinWidth="1000" MinHeight="680"
        Background="#070C17" Foreground="#E7EEF8" FontFamily="Malgun Gothic" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E7EEF8"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E7EEF8"/><Setter Property="Background" Value="#23314A"/>
            <Setter Property="BorderBrush" Value="#3A506D"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#2E4262"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#18243A"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#899BB5"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,6,0,2"/></Style>
        <Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#CC0B1426"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="6"/></Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
        <Border CornerRadius="14" ClipToBounds="True" BorderBrush="#24334B" BorderThickness="1" Margin="0,0,12,0" Background="{Binding SkyBrush}">
            <Grid>
                <Viewport3D IsHitTestVisible="False" Opacity="{Binding StarOpacity}">
                    <Viewport3D.Camera><PerspectiveCamera Position="0,0,0" LookDirection="{Binding LookDirection}" UpDirection="{Binding UpDirection}" FieldOfView="{Binding FieldOfView}" NearPlaneDistance="1" FarPlaneDistance="1000"/></Viewport3D.Camera>
                    <ModelVisual3D Content="{Binding SkyScene}"/>
                </Viewport3D>
                <Viewport3D IsHitTestVisible="False">
                    <Viewport3D.Camera><PerspectiveCamera Position="0,0,0" LookDirection="{Binding LookDirection}" UpDirection="{Binding UpDirection}" FieldOfView="{Binding FieldOfView}" NearPlaneDistance="1" FarPlaneDistance="1000"/></Viewport3D.Camera>
                    <ModelVisual3D Content="{Binding DomeScene}"/>
                </Viewport3D>
                <Viewport3D IsHitTestVisible="False">
                    <Viewport3D.Camera><PerspectiveCamera Position="{Binding CameraPosition}" LookDirection="{Binding LookDirection}" UpDirection="{Binding UpDirection}" FieldOfView="{Binding FieldOfView}" NearPlaneDistance="{Binding FarNearPlane}" FarPlaneDistance="{Binding FarFarPlane}"/></Viewport3D.Camera>
                    <ModelVisual3D Content="{Binding FarScene}"/>
                </Viewport3D>
                <Viewport3D IsHitTestVisible="False">
                    <Viewport3D.Camera><PerspectiveCamera Position="{Binding CameraPosition}" LookDirection="{Binding LookDirection}" UpDirection="{Binding UpDirection}" FieldOfView="{Binding FieldOfView}" NearPlaneDistance="{Binding NearNearPlane}" FarPlaneDistance="{Binding NearFarPlane}"/></Viewport3D.Camera>
                    <ModelVisual3D Content="{Binding NearScene}"/>
                </Viewport3D>
                <Border x:Name="InputSurface" Background="Transparent" MouseLeftButtonDown="OnPointerDown" MouseLeftButtonUp="OnPointerUp" MouseMove="OnPointerMove" MouseWheel="OnMouseWheel"/>

                <!-- Heads-up telemetry -->
                <Border Style="{StaticResource Panel}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Width="330">
                    <StackPanel>
                        <TextBlock Text="{Binding MissionClock}" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="#FFD35A"/>
                        <TextBlock Text="{Binding StageText}" FontSize="13" Foreground="#65DEE0" Margin="0,2,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="고도" Style="{StaticResource Label}"/><TextBlock Grid.Column="1" Text="{Binding AltitudeText}" Style="{StaticResource Value}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="1" Text="속도" Style="{StaticResource Label}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SpeedTextValue}" Style="{StaticResource Value}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Text="가속도" Style="{StaticResource Label}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AccelerationText}" Style="{StaticResource Value}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="3" Text="동압" Style="{StaticResource Label}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PressureText}" Style="{StaticResource Value}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="4" Text="하방거리" Style="{StaticResource Label}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownrangeText}" Style="{StaticResource Value}" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="5" Text="추진제" Style="{StaticResource Label}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PropellantText}" Style="{StaticResource Value}" Margin="0,6,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding OrbitText}" FontSize="11" Foreground="#B7CCE5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False" Padding="10,5">
                    <TextBlock Text="{Binding CameraText}" FontSize="12" Foreground="#B7CCE5"/>
                </Border>
                <TextBlock Text="{Binding CountdownText}" FontFamily="Consolas" FontSize="96" FontWeight="Bold" Foreground="#CCFFD35A"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False"/>
                <Border Style="{StaticResource Panel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,74" IsHitTestVisible="False" Padding="14,6" Visibility="{Binding LatestEventVisibility}">
                    <TextBlock Text="{Binding LatestEvent}" FontSize="16" Foreground="#FFD35A"/>
                </Border>

                <!-- Explanation card -->
                <Border Style="{StaticResource Panel}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,12,0" Width="340" IsHitTestVisible="False"
                        Visibility="{Binding CardVisibility}" BorderBrush="#65DEE0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding CardTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#FFD35A"/>
                        <TextBlock Text="{Binding CardText}" FontSize="12" Foreground="#DCE6F2" TextWrapping="Wrap" LineHeight="19" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Picture-in-picture: onboard camera while chasing (or the reverse); click to swap. -->
                <Button Width="384" Height="216" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,74" Cursor="Hand"
                        Visibility="{Binding InsetVisibility}" Command="{Binding SwapInsetCommand}" AutomationProperties.Name="카메라 전환">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" BorderBrush="#65DEE0" BorderThickness="1.5" ClipToBounds="True" Background="{Binding SkyBrush}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Viewport3D IsHitTestVisible="False" Opacity="{Binding StarOpacity}">
                            <Viewport3D.Camera><PerspectiveCamera Position="0,0,0" LookDirection="{Binding InsetLookDirection}" UpDirection="{Binding InsetUpDirection}" FieldOfView="{Binding InsetFieldOfView}" NearPlaneDistance="1" FarPlaneDistance="1000"/></Viewport3D.Camera>
                            <ModelVisual3D Content="{Binding SkyScene}"/>
                        </Viewport3D>
                        <Viewport3D IsHitTestVisible="False">
                            <Viewport3D.Camera><PerspectiveCamera Position="0,0,0" LookDirection="{Binding InsetLookDirection}" UpDirection="{Binding InsetUpDirection}" FieldOfView="{Binding InsetFieldOfView}" NearPlaneDistance="1" FarPlaneDistance="1000"/></Viewport3D.Camera>
                            <ModelVisual3D Content="{Binding DomeScene}"/>
                        </Viewport3D>
                        <Viewport3D IsHitTestVisible="False">
                            <Viewport3D.Camera><PerspectiveCamera Position="{Binding InsetCameraPosition}" LookDirection="{Binding InsetLookDirection}" UpDirection="{Binding InsetUpDirection}" FieldOfView="{Binding InsetFieldOfView}" NearPlaneDistance="{Binding InsetFarNearPlane}" FarPlaneDistance="{Binding InsetFarFarPlane}"/></Viewport3D.Camera>
                            <ModelVisual3D Content="{Binding FarScene}"/>
                        </Viewport3D>
                        <Viewport3D IsHitTestVisible="False">
                            <Viewport3D.Camera><PerspectiveCamera Position="{Binding InsetCameraPosition}" LookDirection="{Binding InsetLookDirection}" UpDirection="{Binding InsetUpDirection}" FieldOfView="{Binding InsetFieldOfView}" NearPlaneDistance="{Binding InsetNearNearPlane}" FarPlaneDistance="{Binding InsetNearFarPlane}"/></Viewport3D.Camera>
                            <ModelVisual3D Content="{Binding NearScene}"/>
                        </Viewport3D>
                        <Border Background="#B3081425" CornerRadius="4" Padding="6,2" Margin="6" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock Text="{Binding InsetLabel}" FontSize="11" Foreground="#E7EEF8"/>
                        </Border>
                    </Grid>
                </Button>
                <!-- Mission timeline: click to jump -->
                <Border VerticalAlignment="Bottom" Margin="14,0,14,12" Height="52" CornerRadius="8" Background="#CC0B1426" ClipToBounds="False">
                    <Canvas x:Name="TimelineCanvas" Margin="12,0" ClipToBounds="False" Background="Transparent" Cursor="Hand"
                            SizeChanged="OnTimelineSizeChanged" MouseLeftButtonDown="OnTimelineClick" ToolTip="클릭해서 해당 시점으로 이동"/>
                </Border>

                <!-- Control room: flight map, charts, stations, log; the lower-right cell keeps the tracking camera. -->
                <Grid Visibility="{Binding ControlRoomVisibility}" Background="#E6070C17" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="나로우주센터 발사통제 · 비행 감시" FontSize="16" FontWeight="SemiBold" Margin="18,14,0,4" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="비행 궤적 · 지상궤적" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                            <Canvas Width="300" Height="390" ClipToBounds="True">
                                <Canvas.Background>
                                    <ImageBrush ImageSource="Assets/earth.jpg" ViewboxUnits="RelativeToBoundingBox" Viewbox="0.7778,0.25,0.1389,0.3611" Stretch="Fill"/>
                                </Canvas.Background>
                                <Polyline Points="{Binding MapTrack}" Stroke="#FFD35A" StrokeThickness="2.5"/>
                                <Ellipse Width="10" Height="10" Fill="#65DEE0" Margin="-5,-5,0,0" Canvas.Left="{Binding NaroMapPoint.X}" Canvas.Top="{Binding NaroMapPoint.Y}"/>
                                <TextBlock Text="나로" FontSize="11" Canvas.Left="{Binding NaroMapPoint.X}" Canvas.Top="{Binding NaroMapPoint.Y}" Margin="8,-8,0,0"/>
                                <Ellipse Width="8" Height="8" Fill="#46F0B4" Margin="-4,-4,0,0" Canvas.Left="{Binding JejuMapPoint.X}" Canvas.Top="{Binding JejuMapPoint.Y}"/>
                                <TextBlock Text="제주" FontSize="11" Canvas.Left="{Binding JejuMapPoint.X}" Canvas.Top="{Binding JejuMapPoint.Y}" Margin="-30,2,0,0"/>
                                <Ellipse Width="8" Height="8" Fill="#B98CFF" Margin="-4,-4,0,0" Canvas.Left="{Binding PalauMapPoint.X}" Canvas.Top="{Binding PalauMapPoint.Y}"/>
                                <TextBlock Text="팔라우" FontSize="11" Canvas.Left="{Binding PalauMapPoint.X}" Canvas.Top="{Binding PalauMapPoint.Y}" Margin="8,-8,0,0"/>
                                <Ellipse Width="12" Height="12" Fill="White" Stroke="#FFD35A" StrokeThickness="2" Margin="-6,-6,0,0" Canvas.Left="{Binding RocketMapPoint.X}" Canvas.Top="{Binding RocketMapPoint.Y}"/>
                            </Canvas>
                            <TextBlock Text="경도 100°~150°E · 위도 20°S~45°N · 추적소 좌표는 근사" FontSize="10" Foreground="#899BB5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Panel}" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="고도 (0~800 km)" Style="{StaticResource Label}" Margin="0,0,0,2"/>
                                <Border Background="#0B1426" BorderBrush="#24334B" BorderThickness="1"><Canvas Width="300" Height="110"><Polyline Points="{Binding AltitudeChart}" Stroke="#65DEE0" StrokeThickness="2"/></Canvas></Border>
                                <TextBlock Text="관성 속도 (0~8 km/s)" Style="{StaticResource Label}"/>
                                <Border Background="#0B1426" BorderBrush="#24334B" BorderThickness="1"><Canvas Width="300" Height="110"><Polyline Points="{Binding SpeedChart}" Stroke="#FFBC5F" StrokeThickness="2"/></Canvas></Border>
                                <TextBlock Text="0 ~ 1,100 s" FontSize="10" Foreground="#899BB5"/>
                                <TextBlock Text="추적소 (고각)" Style="{StaticResource Label}"/>
                                <TextBlock Text="{Binding StationText}" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" BorderBrush="#65DEE0" BorderThickness="1" CornerRadius="8" Margin="8" Background="Transparent">
                            <TextBlock Text="추적 영상" FontSize="11" Foreground="#65DEE0" Margin="8,4" VerticalAlignment="Top"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="WPF LAUNCH SIMULATION" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="누리호 2차 발사 · 2022-06-21 16:00 KST · 나로우주센터" Foreground="#899BB5" Margin="0,2,0,12"/>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="{Binding PlayText}" Command="{Binding StartCommand}" Background="#163F4A" BorderBrush="#65DEE0" MinWidth="120"/>
                            <Button Content="카운트다운 건너뛰기" Command="{Binding SkipCountdownCommand}" ToolTip="T−15초로 이동"/>
                            <Button Content="처음부터" Command="{Binding ResetCommand}"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Label}"><Run Text="배속 · 현재 "/><Run Text="{Binding SpeedText, Mode=OneWay}"/></TextBlock>
                        <WrapPanel>
                            <Button Content="1×" Command="{Binding SpeedCommand}" CommandParameter="1"/>
                            <Button Content="5×" Command="{Binding SpeedCommand}" CommandParameter="5"/>
                            <Button Content="20×" Command="{Binding SpeedCommand}" CommandParameter="20"/>
                            <Button Content="50×" Command="{Binding SpeedCommand}" CommandParameter="50"/>
                            <Button Content="100×" Command="{Binding SpeedCommand}" CommandParameter="100"/>
                        </WrapPanel>
                        <TextBlock Text="시점" Style="{StaticResource Label}"/>
                        <WrapPanel>
                            <Button Content="자동 연출" Command="{Binding CameraCommand}" CommandParameter="Auto"/>
                            <Button Content="3인칭" Command="{Binding CameraCommand}" CommandParameter="Chase"/>
                            <Button Content="관제소" Command="{Binding CameraCommand}" CommandParameter="ControlRoom"/>
                            <Button Content="탑재 카메라" Command="{Binding CameraCommand}" CommandParameter="Onboard"/>
                            <Button Content="발사대" Command="{Binding CameraCommand}" CommandParameter="Pad"/>
                            <Button Content="지구 전체" Command="{Binding CameraCommand}" CommandParameter="Globe"/>
                        </WrapPanel>
                        <TextBlock Text="3인칭: 드래그로 회전, 휠로 거리 조절" FontSize="10" Foreground="#899BB5"/>
                        <CheckBox Content="설명 카드 표시" IsChecked="{Binding ShowCards}" Foreground="#E7EEF8" Margin="0,8,0,0"/>
                        <CheckBox Content="소리 (합성음)" IsChecked="{Binding SoundOn}" Foreground="#E7EEF8" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,10" Visibility="{Binding ManeuverVisibility}">
                    <StackPanel>
                        <TextBlock Text="정밀 조정 · 위성 분사 (교육용 예시)" Foreground="#FFD35A" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ManeuverStatus}" FontSize="11" Foreground="#B7CCE5" TextWrapping="Wrap" Margin="0,4,0,8" LineHeight="17"/>
                        <Button Content="자동: 다음 원지점에서 원궤도화" Command="{Binding AutoCircularizeCommand}" Background="#163F4A" BorderBrush="#65DEE0"
                                ToolTip="원지점에서 진행 방향으로 분사해 속도를 그 고도의 원궤도 속도까지 올리면, 근지점이 올라가 원궤도가 됩니다."/>
                        <TextBlock Style="{StaticResource Label}"><Run Text="실습 · "/><Run Text="{Binding BurnStepText, Mode=OneWay}"/></TextBlock>
                        <WrapPanel>
                            <Button Content="1" Command="{Binding BurnStepCommand}" CommandParameter="1" Padding="9,4"/>
                            <Button Content="5" Command="{Binding BurnStepCommand}" CommandParameter="5" Padding="9,4"/>
                            <Button Content="10" Command="{Binding BurnStepCommand}" CommandParameter="10" Padding="9,4"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="진행 +" Command="{Binding BurnCommand}" CommandParameter="prograde" ToolTip="속도 증가 → 반대편(180°) 고도가 올라감"/>
                            <Button Content="역진행 −" Command="{Binding BurnCommand}" CommandParameter="retrograde" ToolTip="속도 감소 → 반대편 고도가 내려감"/>
                            <Button Content="법선 +" Command="{Binding BurnCommand}" CommandParameter="normal" ToolTip="궤도면을 기울임 → 경사각 변화 (비용이 큼)"/>
                            <Button Content="법선 −" Command="{Binding BurnCommand}" CommandParameter="antinormal" ToolTip="궤도면을 반대로 기울임"/>
                            <Button Content="바깥 ↑" Command="{Binding BurnCommand}" CommandParameter="radialout" ToolTip="지구 반대 방향 → 원지점·근지점 위치가 돌아감"/>
                            <Button Content="안쪽 ↓" Command="{Binding BurnCommand}" CommandParameter="radialin" ToolTip="지구 방향"/>
                        </WrapPanel>
                        <TextBlock Text="회색 선: 분사 전 궤도 · 하늘색 선: 현재 궤도. Δv 예산 30 m/s는 예시값입니다." FontSize="10" Foreground="#899BB5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Panel}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="비행 기록" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="#B7CCE5"/></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <TextBlock TextWrapping="Wrap" FontSize="10" Foreground="#899BB5"
                           Text="공개 자료(항우연·언론 보도·논문) 기반 재현입니다. 단별 건조 질량, 피치 프로그램, 유도 법칙, 추적소 좌표는 공개되지 않아 근사값을 썼습니다. 자료와 근거: docs/research-nuri-flight2.md"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
